{
  "name": "japanese-pses",
  "version": "2026.8.24",
  "private": true,
  "description": "日本の小学生向け星図教育ゲーム",
  "scripts": {
    "test": "node tests/test_e2e_runner.js",
    "build": "node scripts/build.mjs",
    "db:migrate:local": "wrangler d1 migrations apply japanese-pses-production --local",
    "db:migrate": "wrangler d1 migrations apply japanese-pses-production --remote",
    "db:seed:local": "node scripts/import-game-data-d1.mjs --local",
    "db:seed": "node scripts/import-game-data-d1.mjs --remote",
    "deploy": "npm run test && npm run build && npm run db:migrate && npm run db:seed && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.125.0"
  }
}
